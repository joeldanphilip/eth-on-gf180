[tasks]
bmc
cover

[options]
bmc: mode bmc
cover: mode cover
depth 100
multiclock on

[engines]
smtbmc bitwuzla

[script]
read -formal -D PERIODIC_CLOCKS -D FRAME_MODE axis_async_fifo.v fifo_harness.sv
prep -top fifo_harness
async2sync
dffunmap

[files]
vendor/verilog-ethernet/lib/axis/rtl/axis_async_fifo.v
formal/fifo_harness.sv
