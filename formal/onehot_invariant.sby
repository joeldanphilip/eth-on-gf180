[options]
mode prove
depth 8
multiclock on
[engines]
smtbmc bitwuzla
[script]
read_verilog -formal -D ONEHOT_WRITE axis_async_fifo_banked.v
chparam -set DEPTH 32 -set DATA_WIDTH 2 -set KEEP_ENABLE 0 -set RAM_PIPELINE 2 -set FRAME_FIFO 1 -set DROP_BAD_FRAME 1 axis_async_fifo
prep -top axis_async_fifo
async2sync
dffunmap
[files]
rtl/axis_async_fifo_banked.v
